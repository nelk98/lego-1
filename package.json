{
  "name": "lego-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.2.0 <11"
  },
  "scripts": {
    "dev": "turbo watch dev --filter=@lego/playground --ui=stream",
    "dev:native": "pnpm --filter @lego/playground-native dev",
    "dev:ios": "pnpm --filter @lego/playground-native ios",
    "dev:android": "pnpm --filter @lego/playground-native android",
    "dev:mini": "pnpm --filter @lego/playground-mini dev",
    "build:native": "turbo run build --filter=@lego/playground-native",
    "build:mini": "turbo run build --filter=@lego/playground-mini",
    "build:playground": "turbo run build --filter=@lego/playground",
    "preview:playground": "pnpm --filter @lego/playground preview",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:packages": "node tooling/build/verify-packages.mjs",
    "verify:pack": "pnpm build && node tooling/build/smoke-pack.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm verify:packages",
    "check:ci": "pnpm check && pnpm verify:pack",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "pnpm": {
    "packageExtensions": {
      "@heroui/react@3.2.6": {
        "peerDependencies": {
          "@types/react": ">=19.0.0"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-aria-components@1.22.1": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-aria@3.53.1": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@react-types/shared@3.37.0": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-stately@3.51.0": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "input-otp@1.5.0": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@react-types/shared@3.36.1": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@adobe/react-spectrum@3.47.7": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "babel-plugin-react-compiler@1.0.0": {
        "dependencies": {
          "@types/babel__core": "7.20.5",
          "@types/babel__traverse": "7.28.0",
          "zod": "4.6.7"
        }
      }
    },
    "patchedDependencies": {
      "unconfig@7.5.0": "patches/unconfig@7.5.0.patch",
      "babel-plugin-react-compiler@1.0.0": "patches/babel-plugin-react-compiler@1.0.0.patch"
    },
    "overrides": {
      "schema-utils@^4": "4.7.0"
    }
  }
}
