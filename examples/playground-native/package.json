{
  "name": "@lego/playground-native",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --port 8081",
    "ios": "expo start --port 8081 --ios",
    "android": "expo start --port 8081 --android",
    "build": "expo export --platform ios --platform android",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true }); await rm('.expo', { recursive: true, force: true });\"",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "expo": "58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
