{
  "extends": "../../tooling/typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "types": ["vite/client"],
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
